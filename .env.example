# KeeperHub organization API key (kh_ prefix). Settings > API Keys at app.keeperhub.com
KEEPERHUB_API_KEY=kh_your_key_here
KEEPERHUB_BASE_URL=https://app.keeperhub.com

# Chain access
BASE_RPC_URL=
# Used by the dashboard's live guard-config reads (eth_call to the guard).
BASE_SEPOLIA_RPC_URL=
BASESCAN_API_KEY=

# Receipt store
DATABASE_URL=

# HOLD notifications
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gateway (apps/gateway) — required at boot; the process fails fast naming any that are missing.
# The policy document as JSON. The policy hash is its keccak256, committed onchain before the run.
NOYEET_POLICY={"version":1,"name":"demo","chains":[11155111],"targets":{"allow":[],"selectors":{}},"limits":{"maxNativeValuePerIntent":"0","maxNativeValuePerWindow":"0","windowSeconds":3600,"maxIntentsPerWindow":1,"maxGas":"1500000"},"holdAbove":{"nativeValue":"0"},"approvals":{"maxApproval":"0"},"minInvariants":1}
NOYEET_POLICY_HASH=
NOYEET_GUARD_ADDRESS=0x4Bd0501fb1c0dEecaCD3efd50340Cd82Bb8E7F0f
# Optional; defaults to the bundled executeGuarded ABI.
NOYEET_GUARD_ABI=
# Optional; the gateway listens on 3000 by default.
PORT=3000
