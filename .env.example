# --------------------------------------------------------------- KeeperHub
# Organization API key (kh_ prefix). Settings > API Keys at app.keeperhub.com
KEEPERHUB_API_KEY=kh_your_key_here
KEEPERHUB_BASE_URL=https://app.keeperhub.com

# ------------------------------------------------------------- chain access
# Read by apps/dashboard for the live guard-configuration panel.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ---------------------------------------------------- gateway (apps/gateway)
# Required. The service refuses to start without these rather than failing on
# the first request that happens to need them.
NOYEET_GUARD_ADDRESS=0x4Bd0501fb1c0dEecaCD3efd50340Cd82Bb8E7F0f
NOYEET_POLICY_PATH=apps/gateway/policy.example.json
PORT=8080
NOYEET_VERSION=0.1.0

# ------------------------------------------------------------- circuit breaker
# Consecutive TRANSPORT failures that open the circuit. A simulated revert is a
# correct prediction and never counts. While open, every intent is DENIED: an
# unreachable simulator means the post-state is unknown, and an unknown
# post-state is exactly what this system exists to refuse.
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_MS=30000
BREAKER_SUCCESS_THRESHOLD=2

# ------------------------------------------------------------------ event log
# Redpanda from infra/observability/docker-compose.yml. Port 19092 is the
# host-facing listener; containers use redpanda:9092.
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:19092

# ----------------------------------------------------- anchor (apps/anchor)
ANCHOR_GROUP_ID=noyeet-anchor
ANCHOR_BATCH_SIZE=8
ANCHOR_MAX_BATCH_AGE_MS=15000

# --------------------------------------------------------------- tracing
# The OTel collector from the same compose stack. Tracing being down must never
# take authorization down, so a missing collector is tolerated silently.
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# --------------------------------------------------------------- dashboards
GRAFANA_PASSWORD=changeme
