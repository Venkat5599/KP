# --------------------------------------------------------------- KeeperHub
# Organization API key (kh_ prefix). Settings > API Keys at app.keeperhub.com
KEEPERHUB_API_KEY=kh_your_key_here
KEEPERHUB_BASE_URL=https://app.keeperhub.com

# Chain access
BASE_RPC_URL=
# Used by the dashboard's live guard-config reads (eth_call to the guard).
BASE_SEPOLIA_RPC_URL=
BASESCAN_API_KEY=

# Receipt store — Postgres (Neon-compatible) when set; in-memory otherwise.
DATABASE_URL=

# HOLD notifications — leave unset to run silently (holds still work, no pings).
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard /api/metrics — optional scrape auth. Leave unset for open scrapes.
METRICS_TOKEN=

# Gateway (apps/gateway) — required at boot; the process fails fast naming any that are missing.
# The policy document as JSON. The policy hash is its keccak256, committed onchain before the run.
NOYEET_POLICY={"version":1,"name":"demo","chains":[11155111],"targets":{"allow":[],"selectors":{}},"limits":{"maxNativeValuePerIntent":"0","maxNativeValuePerWindow":"0","windowSeconds":3600,"maxIntentsPerWindow":1,"maxGas":"1500000"},"holdAbove":{"nativeValue":"0"},"approvals":{"maxApproval":"0"},"minInvariants":1}
NOYEET_POLICY_HASH=
NOYEET_GUARD_ADDRESS=0x4Bd0501fb1c0dEecaCD3efd50340Cd82Bb8E7F0f
# Dashboard dapp (apps/dashboard) — the deployed defaults, so a local clone shows
# the live guard immediately. Override to point at your own deployment.
NOYEET_TARGET_ADDRESS=0x2BeaFD2Ed0D8e3831752b3243E7C5b2CA67Fdb0B
NOYEET_EXECUTOR_ADDRESS=0x5Fe224c6A6AFb471517848d5A0C6aa1905cDD582
NOYEET_CHAIN_NAME=Ethereum Sepolia
NOYEET_EXPLORER=https://sepolia.etherscan.io
NOYEET_HEALTH_FACTOR_FLOOR=1400000000000000000
# Chain RPC for the dashboard's live guard reads (eth_call). BASE_SEPOLIA_RPC_URL
# is accepted as a fallback.
NOYEET_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional seed rows for the transactions page (JSON array).
NOYEET_SEED_TRANSACTIONS=
# Optional gateway base URL; the dashboard proxies its holds queue and shows /readyz.
NOYEET_GATEWAY_URL=
# Optional; defaults to the bundled executeGuarded ABI.
NOYEET_GUARD_ABI=
# Optional; the gateway listens on 3000 by default.
PORT=3000

# Keeper (apps/keeper) — required at boot; fails fast naming any that are missing.
KEEPER_RPC_URL=
KEEPER_TARGET_ADDRESS=
KEEPER_GUARD_ADDRESS=
GATEWAY_URL=http://localhost:3000
# Optional overrides (wei).
KEEPER_HF_FLOOR=1400000000000000000
KEEPER_HF_TARGET=1500000000000000000
KEEPER_INTERVAL_SECONDS=60
KEEPER_CHAIN_ID=11155111
KEEPER_ID_PREFIX=keeper

# Anchoring (bun run anchor) — required at boot; fails fast. The signing wallet must
# be the AnchorStore admin.
ANCHOR_ADDRESS=
ANCHOR_CHAIN_ID=11155111

# ------------------------------------------------------------- circuit breaker
# Consecutive TRANSPORT failures that open the circuit. A simulated revert is a
# correct prediction and never counts toward it. While the circuit is open every
# intent is DENIED: an unreachable simulator means the post-state is unknown, and
# an unknown post-state is exactly what this system exists to refuse.
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_MS=30000
BREAKER_SUCCESS_THRESHOLD=2

# ------------------------------------------------------------------ event log
# Redpanda, from infra/observability/docker-compose.yml. Port 19092 is the
# host-facing listener; other containers use redpanda:9092.
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:19092

# ------------------------------------------------------- anchor consumer
ANCHOR_GROUP_ID=noyeet-anchor
ANCHOR_BATCH_SIZE=8
ANCHOR_MAX_BATCH_AGE_MS=15000

# ---------------------------------------------------------------- tracing
# The OTel collector from the same compose stack. Tracing being down must never
# take authorization down, so a missing collector is tolerated silently.
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# ------------------------------------------------------------- dashboards
GRAFANA_PASSWORD=changeme
