# Copy to .env and fill in. Everything is documented; nothing is required to run the
# test suite.

# The noyeet gateway. Local: http://localhost:3000 (bun run start in apps/gateway).
GATEWAY_URL=http://localhost:3000

# KeeperHub org API key — needed only for the broadcast step (/v1/execute).
KEEPERHUB_API_KEY=kh_your_key_here

# The demo intent (a health-factor rebalance on Sepolia). Override to point at your
# own position contract and guard.
CHAIN_ID=11155111
TARGET_ADDRESS=0x2BeaFD2Ed0D8e3831752b3243E7C5b2CA67Fdb0B
GUARD_ADDRESS=0x4Bd0501fb1c0dEecaCD3efd50340Cd82Bb8E7F0f
HEALTH_FACTOR_FLOOR=1400000000000000000
HEALTH_FACTOR_TARGET=1500000000000000000
